	printf '"head_include":['
	_first=1
	for _h in $(uget tor.conf.head_include); do
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '"%s"' "$(esc "$_h")"
	done
	printf '],"tail_include":['
	_first=1
	for _t in $(uget tor.conf.tail_include); do
		[ "$_first" = 1 ] || printf ','
