case "$1" in
list)
	echo '{ "status": {}, "config": {}, "devices": {}, "traffic": {}, "monitor": {}, "packages": {}, "bridge-types": {}, "destinations": {}, "test-bridge": {}, "bridge-mon": {}, "install-package": {}, "apply-bridges": {}, "apply-routing": {}, "apply-monitor": {} }'
	;;
call)
	case "$2" in
	status) do_status ;;
	config) do_config ;;
	devices) do_devices ;;
	traffic) do_traffic ;;
	monitor) do_monitor ;;
	packages) do_packages ;;
	test-bridge) do_test_bridge ;;
	bridge-mon) do_bridge_mon ;;
	bridge-mon-now) do_bridge_mon_now ;;
	bridge-types) do_bridge_types ;;
	install-package) do_install_package "$3" ;;
	destinations) do_destinations ;;
	apply-bridges) do_apply_bridges ;;
