# какие пакеты нужны для каждого типа моста
do_bridge_types() {
	printf '{'
	printf '"vanilla":{"package":"","installed":true},'
	printf '"obfs4":{"package":"obfs4proxy","installed":%s},' \
		"$(apk list --installed 2>/dev/null | grep -qE '^obfs4proxy-[0-9]' && echo true || echo false)"
