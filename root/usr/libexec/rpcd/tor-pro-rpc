# --- назначения (кто куда ходит через tor) -------------------------------------

do_destinations() {
	if [ ! -f "$CT_STATE" ]; then
		printf '{"destinations":[]}'
		return 0
	fi
	printf '{"destinations":['
	awk '
		$1 == "TOTAL" { next }
		{
			n = split($1, f, "|")
			if (n < 4) next
			ip = f[1]; dst = f[2]; dport = f[4]
			key = ip "|" dst
			if (!(key in seen)) { seen[key] = 1; order[++c] = key }
			agg[key] = agg[key] + ($2 + 0)
			aggp[key] = aggp[key] + ($3 + 0)
			sport[key] = dport
		}
		END {
			first = 1
			for (i = 1; i <= c; i++) {
				k = order[i]
				split(k, p, "|")
				if (first == 0) printf ","
				first = 0
				printf "{\"ip\":\"%s\",\"dst\":\"%s\",\"port\":\"%s\",\"bytes\":%d,\"packets\":%d}", \
					p[1], p[2], sport[k], agg[k], aggp[k]
			}
		}
	' "$CT_STATE"
	printf ']}'
}

# --- применение настроек -----------------------------------------------------

do_apply_bridges() {
	# собираем строки Bridge из параметров каждого моста
	{
		echo "## Generated by luci-app-tor, do not edit"
		uci -q show tor_pro 2>/dev/null | grep "=bridge$" | cut -d= -f1 | cut -d. -f2 | while read -r _sec; do
			_en=$(uci -q get "tor_pro.$_sec.enabled" 2>/dev/null)
			[ "$_en" = "1" ] || continue
			_type=$(uci -q get "tor_pro.$_sec.type" 2>/dev/null)
			[ -n "$_type" ] || _type="vanilla"
			_addr=$(uci -q get "tor_pro.$_sec.addr" 2>/dev/null)
			_fp=$(uci -q get "tor_pro.$_sec.fingerprint" 2>/dev/null)
			_url=$(uci -q get "tor_pro.$_sec.url" 2>/dev/null)
			_ice=$(uci -q get "tor_pro.$_sec.ice" 2>/dev/null)
			_line=$(uci -q get "tor_pro.$_sec.line" 2>/dev/null)

			if [ -n "$_addr" ]; then
				_cert=$(uci -q get "tor_pro.$_sec.cert" 2>/dev/null)
				_iat=$(uci -q get "tor_pro.$_sec.iat" 2>/dev/null)
				case "$_type" in
				obfs4)
					_line="obfs4 $_addr $_fp"
					[ -n "$_cert" ] && _line="$_line cert=$_cert"
					[ -n "$_iat" ] && _line="$_line iat-mode=$_iat"
					;;
				snowflake)
					_line="snowflake $_addr $_fp"
					[ -n "$_url" ] && _line="$_line url=$_url"
					[ -n "$_ice" ] && _line="$_line ice=$_ice"
					;;
				meek-azure)
					_line="meek-azure $_addr"
					[ -n "$_url" ] && _line="$_line url=$_url"
					;;
				*)
					_line="$_addr"
					[ -n "$_fp" ] && _line="$_line $_fp"
					;;
				esac
			fi

			# пустая строка — мост без адреса, пропускаем
			[ -n "$_line" ] || continue
			# произвольные доп. параметры (ampcache=, front=, utls-imitate= и т.п.)
			_extra=$(uci -q get "tor_pro.$_sec.extra" 2>/dev/null)
			[ -n "$_extra" ] && _line="$_line $_extra"
			_c=$(uci -q get "tor_pro.$_sec.comment" 2>/dev/null)
			if [ -n "$_c" ]; then
				printf 'Bridge %s # %s\n' "$_line" "$_c"
			else
				printf 'Bridge %s\n' "$_line"
			fi
		done

		# transport-плагины: tor требует ClientTransportPlugin для каждого
		# используемого типа моста (иначе мосты молча игнорируются с warning
		# «no configured transport»); в /etc/tor/torrc плагины уже могут быть
		# прописаны — их не дублируем
		for _s in $(uci -q show tor_pro 2>/dev/null | grep '=bridge$' | cut -d= -f1 | cut -d. -f2); do
			[ "$(uci -q get "tor_pro.$_s.enabled" 2>/dev/null)" = "1" ] || continue
			uci -q get "tor_pro.$_s.type" 2>/dev/null
		done | sort -u | while read -r _t; do
			case "$_t" in
				obfs4) _bin=/usr/bin/obfs4proxy ;;
				meek-azure|meek_lite|meek) _bin=/usr/bin/meek-client ;;
				snowflake) _bin=/usr/bin/snowflake-client ;;
				*) continue ;;
			esac
			[ -x "$_bin" ] || continue
			grep -q "ClientTransportPlugin[[:space:]].*$_t" /etc/tor/torrc && continue
			printf 'ClientTransportPlugin %s exec %s\n' "$_t" "$_bin"
		done

		# уникальное имя tmp: два одновременных apply иначе перемешивают
		# содержимое одного и того же .tmp и портят итоговый файл
		_tmp="$BRIDGES_FILE.tmp.$$"
	} > "$_tmp" 2>/dev/null

	mv "$_tmp" "$BRIDGES_FILE" 2>/dev/null
	chmod 600 "$BRIDGES_FILE" 2>/dev/null

	# подключаем файл мостов в конфиг tor
	_have=0
	for _t in $(uget tor.conf.tail_include); do
		[ "$_t" = "$BRIDGES_FILE" ] && _have=1
	done
	[ "$_have" = 1 ] || {
		uci -q add_list tor.conf.tail_include="$BRIDGES_FILE" 2>/dev/null
		uci -q commit tor 2>/dev/null
	}

	# перезапуск tor
	/etc/init.d/tor restart >/dev/null 2>&1
	printf '{"status":"ok","bridges_file":"%s"}' "$(esc "$BRIDGES_FILE")"
}

do_apply_routing() {
	# при первом применении подхватываем текущий список клиентов из firewall
	import_clients

	# список клиентов берём из tor_pro (секции типа client) и пишем в ipset firewall
	_ips=""
	for _sec in $(uci -q show tor_pro 2>/dev/null | grep '=client$' | cut -d= -f1 | cut -d. -f2); do
		_en=$(uci -q get "tor_pro.$_sec.enabled" 2>/dev/null)
		[ "$_en" = "1" ] || continue
		_ip=$(uci -q get "tor_pro.$_sec.ip" 2>/dev/null)
		[ -n "$_ip" ] || continue
		_ips="$_ips $_ip"
	done

	# создаём/обновляем секцию ipset в firewall
	cp /etc/config/firewall "$FW_BACKUP" 2>/dev/null
	_sec=$(ipset_section)
	if [ -z "$_sec" ]; then
		# секции нет — создаём именованную
		uci -q set "firewall.$IPSET_NAME=ipset" 2>/dev/null
		uci -q set "firewall.$IPSET_NAME.name=$IPSET_NAME" 2>/dev/null
		uci -q set "firewall.$IPSET_NAME.family=ipv4" 2>/dev/null
		uci -q set "firewall.$IPSET_NAME.storage=hash" 2>/dev/null
		_sec="$IPSET_NAME"
	fi
	# поддержка подсетей: match 'net' -> интервальный nft-set (принимает и IP, и CIDR)
	uci -q delete "firewall.$_sec.match" 2>/dev/null
	uci -q add_list "firewall.$_sec.match=net" 2>/dev/null
	uci -q delete "firewall.$_sec.entry" 2>/dev/null
	for _ip in $_ips; do
		[ -n "$_ip" ] || continue
		uci -q add_list "firewall.$_sec.entry=$_ip" 2>/dev/null
	done
	uci -q commit firewall 2>/dev/null

	# страховка: если новый конфиг невалиден — откатываем
	if ! fw4 print >/dev/null 2>&1; then
		[ -f "$FW_BACKUP" ] && cp "$FW_BACKUP" /etc/config/firewall
		fw4 reload >/dev/null 2>&1
		printf '{"status":"error","reason":"invalid firewall configuration, reverted"}'
		return 0
	fi

	# пересоздаём таблицу мониторинга под новый список
	apply_monitor_table

	# если живой set не имеет флага interval — пересоздаём таблицу fw4,
	# иначе nft не даст сменить тип set при reload.
	# элементы set'а fw4 при reload не очищаются, поэтому чистим их явно.
	_live=$(nft list set inet fw4 "$IPSET_NAME" 2>/dev/null)
	if [ -n "$_live" ]; then
		case "$_live" in
		*"flags interval"*) nft flush set inet fw4 "$IPSET_NAME" 2>/dev/null ;;
		*) nft delete table inet fw4 2>/dev/null ;;
		esac
	fi

	/etc/init.d/firewall reload >/dev/null 2>&1
	printf '{"status":"ok","clients":%s}' "$(
		_first=1
		printf '['
		for _ip in $_ips; do
			[ "$_first" = 1 ] || printf ','
			_first=0
			printf '"%s"' "$(esc "$_ip")"
		done
		printf ']'
	)"
}

do_apply_monitor() {
	if apply_monitor_table; then
		printf '{"status":"ok"}'
	else
		printf '{"status":"error"}'
	fi
}

