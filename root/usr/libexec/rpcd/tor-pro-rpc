	printf '"refresh":"%s","monitor_enabled":"%s","use_vanilla":"%s","use_obfs4":"%s","use_snowflake":"%s","use_meek_azure":"%s","log_lines":"%s","bridge_mon_enabled":"%s","bridge_mon_interval":"%s"' \
		"$(esc "$(uget tor_pro.settings.refresh)")" \
