			"$([ -f "$_i" ] && echo true || echo false)"
	done
	printf '],'
	printf '"torrc":"%s","generated":"%s","torrc_exists":%s,"generated_exists":%s,' \
		"$(esc "$TORRC")" "$(esc "$TORRC_GEN")" \
		"$([ -f "$TORRC" ] && echo true || echo false)" \
		"$([ -f "$TORRC_GEN" ] && echo true || echo false)"
	printf '"uci":{'
